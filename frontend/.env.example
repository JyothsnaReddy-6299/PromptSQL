# =====================================================================
# PromptSQL Frontend Environment Configuration Template
# =====================================================================
#
# Option A: Single-Origin Deployment (Default)
# When the FastAPI backend directly serves the compiled frontend/dist files,
# leave VITE_API_URL empty or unset. All requests use relative URLs.
#
VITE_API_URL=

# Option B: Separate-Origin Deployment
# When hosting frontend (e.g. Vercel, Netlify, Cloudflare Pages) and
# backend (e.g. Render, Railway, AWS ECS, Fly.io) on distinct origins:
# Set VITE_API_URL to your backend API base URL (without trailing slash):
# VITE_API_URL=https://api.promptsql.example.com
