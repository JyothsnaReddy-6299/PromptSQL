# =====================================================================
# PromptSQL Environment Configuration Template
# Copy this file to 'backend/.env' and provide your actual credentials.
# NEVER commit the real '.env' file or production secrets to Git!
# =====================================================================

APP_ENV=development
DEBUG=false

# Database Configuration
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=promptsql_db

# JWT Authentication Security (min 32 characters in production)
JWT_SECRET=your-minimum-32-character-cryptographically-secure-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# CORS Configuration
CORS_ORIGINS=*
